# 1.4.9 is the verified published stable Docker Hub tag on 2026-10-29.
# It DOES NOT contain unreleased changes in this fork. Build the fork's Docker
# image and change ARCHESTRA_IMAGE if you want to run this branch's code.
ARCHESTRA_IMAGE=archestra/platform:1.4.9

# Docker Desktop host Ollama: these defaults work when Ollama is reachable at
# host.docker.internal. Linux requires an explicit host-gateway and appropriate
# Ollama binding/firewall configuration.
ARCHESTRA_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
ARCHESTRA_OLLAMA_NATIVE_BASE_URL=http://host.docker.internal:11434

# Enable Bedrock IAM only when the container has a configured AWS identity.
ARCHESTRA_BEDROCK_IAM_AUTH_ENABLED=false
ARCHESTRA_BEDROCK_REGION=us-east-1
ARCHESTRA_BEDROCK_BASE_URL=
# Local admin password is generated by bash deploy/local/up.sh into .env (0600).
# NEVER use the upstream quickstart's published default password.
# Store Ollama Cloud/API and Bedrock credentials in the app's encrypted provider
# store (or an external secret manager), never in this tracked example.
